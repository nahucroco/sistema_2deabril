# Copiá este archivo a .env y completá los valores. Nunca subas el .env real al repo.

DEBUG=True
SECRET_KEY=cambiar-esto-por-algo-random
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (en desarrollo local podés dejar sqlite y borrar esta seccion de settings)
DATABASE_URL=postgres://sistema:sistema@localhost:5432/sistema_2deabril

# Redis para Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# True = correr las tareas sin Redis ni worker (solo para probar en local)
CELERY_TASK_ALWAYS_EAGER=False

# Meta / Instagram Graph API
# Se cargan ACA, no en el admin ni en la base, porque son secretos de la app.
# El access token del LOCAL (de larga duracion, por cuenta) se guarda cifrado en la base,
# ver stories/models.py InstagramAccount.
META_APP_ID=
META_APP_SECRET=
GRAPH_API_VERSION=v27.0

# Anthropic (sugerencias de texto con Claude)
ANTHROPIC_API_KEY=

# URL publica de la carpeta /media/ (Meta necesita descargar la imagen por internet).
# En produccion: https://tu-dominio.com/media. En local: la URL del tunel al servidor de media,
# ver docs/instagram_setup.md.
PUBLIC_MEDIA_BASE_URL=https://tu-dominio.com/media
