# Caddy saca y renueva solo el certificado HTTPS para {$DOMAIN} (Let's Encrypt).
{$DOMAIN} {
	encode gzip

	# Fotos grandes del celular: margen de sobra para el PNG de 1080x1920.
	request_body {
		max_size 20MB
	}

	# El Taller de Publicaciones (React compilado con base /panel/).
	redir /panel /panel/
	handle_path /panel/* {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}

	# CSS de la web y archivos del admin de Django (collectstatic).
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	# Fotos de productos e imagenes de las historias (Meta las descarga de aca).
	# file_server sin "browse" no lista carpetas.
	handle /media/* {
		root * /srv
		file_server
	}

	# Todo lo demas lo atiende Django: la web publica, /api y /admin.
	handle {
		reverse_proxy backend:8000
	}
}
