# Caddy saca y renueva solo el certificado HTTPS para {$DOMAIN} (Let's Encrypt).
{$DOMAIN} {
	encode gzip

	# Fotos grandes del celular: margen de sobra para el PNG de 1080x1920.
	request_body {
		max_size 20MB
	}

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}

	# Archivos del admin de Django (collectstatic).
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	# Imagenes de las historias: Meta las descarga de aca para publicarlas.
	# file_server sin "browse" no lista carpetas.
	handle /media/* {
		root * /srv
		file_server
	}

	# El Taller (React compilado). Cualquier otra ruta cae en index.html.
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
