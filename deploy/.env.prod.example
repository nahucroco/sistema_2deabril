# Copiar a .env.prod (en la raiz del repo, en el servidor) y completar.
# .env.prod NUNCA se sube al repo: el repo es publico.

# Dominio con el que se entra a la app, sin https:// (ej. bici2deabril.duckdns.org)
DOMAIN=

# Contraseña de la base de datos. Generala con:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Clave secreta de Django. Generala con:  openssl rand -hex 50
SECRET_KEY=

# Opcional: sugerencias de texto con Claude (paso 3 del Taller)
ANTHROPIC_API_KEY=
